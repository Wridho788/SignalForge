# SignalForge — copy to .env.local for local overrides. Never commit real values.
# No secrets belong here: AI provider auth is handled by the official CLI login flows.

# The server always binds to 127.0.0.1:3000 (see the dev/start scripts in package.json).
# Changing that requires a reviewed ADR and security plan (AGENTS.md).

# Directory for the local SQLite database and pre-migration backups.
# Relative paths resolve from the working directory. Must not be inside public/.
SIGNALFORGE_DATA_DIR=./.data
